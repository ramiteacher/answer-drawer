# Firebase 웹 설정 — 프리캔버스AI(marketgen-ai-87525) 프로젝트의 공개 클라이언트 값을 그대로 쓴다.
# 값은 marketgen-ai 저장소의 .env.local 또는 Firebase 콘솔 > 프로젝트 설정 > 웹 앱에서 복사한다.
# 배포 빌드는 GitHub Actions secrets(같은 이름)로 주입한다. 없으면 빌드가 실패한다.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 로컬 에뮬레이터로 검증할 때만 1 (firebase.emulator.json · npm run emulators)
# VITE_FIREBASE_EMULATOR=1
